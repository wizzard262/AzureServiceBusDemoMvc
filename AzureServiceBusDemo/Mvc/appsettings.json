{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceBus": {
    // Authenticate using DefaultAzureCredential, so it works locally when Visual Studio is logged in (jones.steve@live.com)
    // (except my VS login is not my Azure login, so I have to use Azure CLI to login with the correct account)
    // tit tries multiple authentication methods (Environment variables, Managed Identity, Visual Studio, Azure CLI, etc.) and uses the first one that works
    // In Azure the ManagedIdentity of the App Service/Function must have RBAC access (e.g. Azure Service Bus Data Sender/Receiver) on the ServiceBus namespace
    "FullyQualifiedNamespace": "wizzard262.servicebus.windows.net",
    "QueueName": "demo-asb-queue",
    "TopicName": "demo-asb-topic"
  }
}