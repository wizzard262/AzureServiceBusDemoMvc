@model TopicViewModel

<div class="d-flex align-items-center mb-3">
    <h2 class="me-3 mb-0">Azure Service Bus Demo</h2>
    <img src="images/topics.png" style="height:80px;" />
</div>

<div class="card mb-3 bg-primary-subtle">
    <div class="card-body">
        <h4>Not Implemented</h4>
        Azure Service Bus Topics are not available on the free tier.
        <br />
        The planned demo would have done:

        <ul>
            <li>
                <strong>Send</strong> – Send Azure Service Bus Topic messages from this page.
            </li>
            <li>
                <strong>Azure Function #1</strong> – Triggered by a Subscription to the Service Bus Topic.<br />
                Pushes a message to a SignalR hub.
            </li>
            <li>
                <strong>Azure Function #2</strong> – Triggered by a Subscription to the Service Bus Topic.<br />
                Pushes a message to a SignalR hub.
            </li>
            <li>
                <strong>Azure SignalR</strong> – This page exposes a SignalR hub.<br />
                The page would list live updates such as:
                <ul>
                    <li><i>"Message X processed by Function #1"</i></li>
                    <li><i>"Message X processed by Function #2"</i></li>
                    <li><i>"Message Y processed by Function #1"</i></li>
                    <li><i>"Message Y processed by Function #2"</i></li>
                </ul>
            </li>
        </ul>
    </div>
</div>
